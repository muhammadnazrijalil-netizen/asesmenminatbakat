  {type:"C",text:"Kamu tertarik pelajaran akuntansi, ekonomi, atau cara mengelola keuangan."},
  {type:"C",text:"Kamu suka membuat laporan, spreadsheet, atau rekap data karena merasa itu penting dan berguna."},
  {type:"C",text:"Kamu tidak masalah melakukan pekerjaan berulang asalkan hasilnya akurat dan tepat."},
  {type:"C",text:"Kamu merasa tenang saat semuanya berjalan sesuai rencana dan prosedur yang sudah ada."},
  {type:"C",text:"Kamu suka mengatur keuangan pribadi, misalnya mencatat pengeluaran jajan atau menabung."},
  {type:"C",text:"Kamu lebih suka bekerja dalam sistem yang sudah jelas daripada situasi yang tidak pasti."},
];

let answers=new Array(60).fill(null),cur=0,finalScores=null,finalCode="";

function render(){
  const q=questions[cur];
  const badge=document.getElementById("q-badge");
  badge.textContent=TYPES[q.type].name+" ("+q.type+")";
  badge.style.cssText=BADGE_STYLE[q.type];
  document.getElementById("q-text").textContent=q.text;
  document.getElementById("prog-label").textContent="Pertanyaan "+(cur+1)+" dari 60";
  document.getElementById("prog-fill").style.width=((cur+1)/60*100).toFixed(1)+"%";
  document.getElementById("q-counter").textContent=(cur+1)+" / 60";
  document.getElementById("nav-counter").textContent=(cur+1)+" / 60";
  document.getElementById("btn-prev").disabled=cur===0;
  document.getElementById("btn-next").textContent=cur===59?"Lihat Hasil ✓":"Lanjut →";
  ["opt-no","opt-neu","opt-yes"].forEach((id,i)=>{
    const b=document.getElementById(id);
    b.className="opt-btn";
    if(answers[cur]===i)b.classList.add(i===0?"sel-no":i===1?"sel-neu":"sel-yes");
  });
}

function answer(val){
  answers[cur]=val; render();
  setTimeout(()=>{if(cur<59){cur++;render();}else{showResult();}},200);
}
function next(){if(cur<59){cur++;render();}else{showResult();}}
function prev(){if(cur>0){cur--;render();}}

function showResult(){
  const scores={R:0,I:0,A:0,S:0,E:0,C:0};
  questions.forEach((q,i)=>{if(answers[i]!==null)scores[q.type]+=answers[i];});
  finalScores=scores;
  const maxScore=20;
  const sorted=Object.entries(scores).sort((a,b)=>b[1]-a[1]);
  finalCode=sorted.slice(0,3).map(x=>x[0]).join("");
  document.getElementById("r-code").textContent=finalCode;

  document.getElementById("r-bars").innerHTML=sorted.map(([t,s])=>{
    const pct=Math.round(s/maxScore*100);
    return`<div class="bar-row"><div class="bar-lbl"><strong>${TYPES[t].name}</strong><span>${t}</span></div><div class="bar-track"><div class="bar-fill" style="width:0%;background:${BAR_COLORS[t]}" data-pct="${pct}"></div></div><div class="bar-score">${s}/20</div></div>`;
  }).join("");

  const top3=sorted.slice(0,3).map(x=>x[0]);
  document.getElementById("r-cards").innerHTML=sorted.map(([t])=>{
    const isTop=top3.includes(t);
    return`<div class="type-card ${isTop?"top":""}">
      ${isTop?'<div class="top-badge">✦ Dominan</div>':''}
      <h3>${TYPES[t].name} (${t})</h3>
      <p>${TYPES[t].desc}</p>
      ${isTop?`<p class="major">Jurusan: ${TYPES[t].major}</p>`:''}
    </div>`;
  }).join("");

  const topJobs=[...new Set([...JOBS[top3[0]],...JOBS[top3[1]],...JOBS[top3[2]]])].slice(0,12);
  document.getElementById("r-jobs").innerHTML=`<h3>Karir yang Cocok untuk Kode ${finalCode}</h3>
    <div class="job-chips">${topJobs.map(j=>`<span class="chip">${j}</span>`).join("")}</div>`;

  document.getElementById("quiz-section").style.display="none";
  document.getElementById("result-section").style.display="block";
  window.scrollTo({top:0,behavior:"smooth"});
  setTimeout(()=>{
    document.querySelectorAll(".bar-fill").forEach(el=>{el.style.width=el.dataset.pct+"%";});
  },200);
}

async function getAIAdvice(){
  const btn=document.getElementById("btn-ai");
  const box=document.getElementById("ai-box");
  const content=document.getElementById("ai-content");
  btn.disabled=true;
  btn.innerHTML='<span class="spinner"></span>Sedang membuat panduan karir...';
  box.style.display="block";
  content.textContent="Menghubungi AI, mohon tunggu sebentar...";
  const sorted=Object.entries(finalScores).sort((a,b)=>b[1]-a[1]);
  const scoreText=sorted.map(([t,s])=>TYPES[t].name+" ("+t+"): "+s+"/20").join(", ");
  const top3=sorted.slice(0,3).map(x=>x[0]);
  const majorText=top3.map(t=>TYPES[t].major).join("; ");
  const prompt=`Kamu adalah konselor karir sekolah menengah atas yang ramah dan memotivasi. Seorang siswa SMA baru saja menyelesaikan asesmen karir Holland dan mendapat hasil berikut:\n\nKode Holland: ${finalCode}\nSkor detail: ${scoreText}\nTipe dominan: ${top3.map(t=>TYPES[t].name).join(", ")}\nJurusan yang relevan: ${majorText}\n\nBerikan panduan karir yang hangat, personal, dan memotivasi untuk siswa ini dengan format:\n1. Penjelasan singkat tentang kepribadian karirnya (2-3 kalimat, gunakan "kamu")\n2. Rekomendasi 3-5 jurusan kuliah yang paling cocok beserta alasannya\n3. Tips memilih lingkungan kerja dan pekerjaan yang cocok\n4. Satu kalimat motivasi penutup yang menyemangati\n\nGunakan bahasa Indonesia yang santai dan ramah untuk siswa SMA. Jangan terlalu formal.`;
  try{
    const resp=await fetch("https://api.anthropic.com/v1/messages",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({model:"claude-sonnet-4-20250514",max_tokens:1000,messages:[{role:"user",content:prompt}]})});
    const data=await resp.json();
    const text=data.content?.filter(b=>b.type==="text").map(b=>b.text).join("")||"Maaf, tidak bisa mendapatkan respons.";
    content.textContent=text;
    btn.innerHTML='<i class="ti ti-check"></i> Panduan sudah dimuat ✓';
  }catch(e){
    content.textContent="Maaf, terjadi kesalahan. Pastikan kamu terhubung ke internet dan coba lagi.";
    btn.disabled=false;
    btn.innerHTML='<i class="ti ti-sparkles"></i> Coba lagi';
  }
}

function exportPDF(){
  // Build a self-contained printable page and trigger browser print-to-PDF
  const sorted=Object.entries(finalScores).sort((a,b)=>b[1]-a[1]);
  const top3=sorted.slice(0,3).map(x=>x[0]);
  const maxScore=20;
  const aiText=document.getElementById("ai-content").textContent||"";
  const hasAI=aiText.length>30&&!aiText.includes("Menghubungi");
  const topJobs=[...new Set([...JOBS[top3[0]],...JOBS[top3[1]],...JOBS[top3[2]]])].slice(0,12);
  const dateStr=new Date().toLocaleDateString("id-ID",{day:"numeric",month:"long",year:"numeric"});

  const barsHtml=sorted.map(([t,s])=>{
    const pct=Math.round(s/maxScore*100);
    return`<div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
      <div style="width:140px;flex-shrink:0"><strong style="font-size:13px;color:${TYPES[t].color}">${TYPES[t].name} (${t})</strong></div>
      <div style="flex:1;height:10px;background:#eee;border-radius:5px;overflow:hidden"><div style="width:${pct}%;height:100%;background:${TYPES[t].color};border-radius:5px"></div></div>
      <div style="width:36px;text-align:right;font-size:13px;font-weight:600">${s}/20</div>
    </div>`;
  }).join("");

  const cardsHtml=top3.map(t=>`
    <div style="border:2px solid ${TYPES[t].color};border-radius:10px;padding:12px;margin-bottom:10px">
      <div style="font-size:13px;font-weight:700;color:${TYPES[t].color};margin-bottom:4px">${TYPES[t].name} (${t})</div>
      <div style="font-size:12px;color:#444;line-height:1.5;margin-bottom:4px">${TYPES[t].desc}</div>
      <div style="font-size:11px;color:#888;font-style:italic">Jurusan: ${TYPES[t].major}</div>
    </div>`).join("");

  const jobsHtml=topJobs.map(j=>`<span style="display:inline-block;padding:4px 12px;background:#f2f1fa;border:1px solid #c9c5f0;border-radius:999px;font-size:12px;color:#534AB7;margin:3px">${j}</span>`).join("");

  const aiHtml=hasAI?`
    <div style="margin-top:20px;padding:14px;background:#f8f8fc;border-left:4px solid #534AB7;border-radius:4px">
      <div style="font-size:13px;font-weight:700;color:#534AB7;margin-bottom:8px">Panduan Karir dari AI</div>
      <div style="font-size:12px;color:#444;line-height:1.7;white-space:pre-wrap">${aiText}</div>
    </div>`:"";

  const html=`<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8">
    <title>Hasil Asesmen Holland ${finalCode}</title>
    <style>
      body{font-family:Arial,sans-serif;color:#1a1a2e;margin:0;padding:0}
      .header{background:#534AB7;color:#EEEDFE;padding:24px;text-align:center}
      .header h1{font-size:22px;margin:0 0 4px}
      .header p{font-size:12px;margin:0;opacity:.8}
      .content{padding:24px 28px;max-width:680px;margin:0 auto}
      .code-box{background:#EEEDFE;border-radius:10px;padding:16px;text-align:center;margin-bottom:20px}
      .code-lbl{font-size:12px;color:#534AB7;font-weight:600;margin-bottom:4px}
      .code-val{font-size:42px;font-weight:700;color:#3C3489;letter-spacing:.2em}
      .sec{font-size:13px;font-weight:700;color:#534AB7;text-transform:uppercase;letter-spacing:.06em;margin:18px 0 8px;border-bottom:2px solid #EEEDFE;padding-bottom:4px}
      @media print{body{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
    </style>
  </head><body>
    <div class="header">
      <h1>Asesmen Kunci Karir Holland</h1>
      <p>Profil RIASEC &nbsp;|&nbsp; ${dateStr}</p>
    </div>
    <div class="content">
      <div class="code-box">
        <div class="code-lbl">Kode Holland Kamu</div>
        <div class="code-val">${finalCode}</div>
      </div>
      <div class="sec">Skor per Tipe Kepribadian</div>
      ${barsHtml}
      <div class="sec">Tipe Kepribadian Dominan</div>
      ${cardsHtml}
      <div class="sec">Rekomendasi Karir untuk Kode ${finalCode}</div>
      <div style="margin-bottom:8px">${jobsHtml}</div>
      ${aiHtml}
      <div style="margin-top:28px;padding-top:12px;border-top:1px solid #eee;text-align:center;font-size:11px;color:#aaa">
        Asesmen Kunci Karir Holland &mdash; Berdasarkan Teori John L. Holland
      </div>
    </div>
  </body></html>`;

  const win=window.open("","_blank","width=800,height=900");
  if(!win){alert("Popup diblokir! Mohon izinkan popup di browser kamu, lalu coba lagi.");return;}
  win.document.write(html);
  win.document.close();
  win.onload=function(){
    setTimeout(()=>{win.focus();win.print();},400);
  };
}

function restart(){
  answers=new Array(60).fill(null);cur=0;finalScores=null;finalCode="";
  document.getElementById("quiz-section").style.display="block";
  document.getElementById("result-section").style.display="none";
  document.getElementById("ai-box").style.display="none";
  document.getElementById("ai-content").textContent="";
  document.getElementById("btn-ai").disabled=false;
  document.getElementById("btn-ai").innerHTML='<i class="ti ti-sparkles"></i> Minta panduan karir dari AI';
  window.scrollTo({top:0,behavior:"smooth"});
  render();
}

render();
</script>
</body>
</html>
